%% Simplified model of a non-holonomic ground vehicle
%% the mass is a function of time of the form 
%% m(t) = m_0 - frac{ m_0 - m_{min} }{T_m} t forall 0 \leq t < T_m
%% m(t) = m_{min} forall t\geq T_m
$$ Observation: Intertia rate of change is not yet mdeled

clear; clc; close all;

%% 1. Parametros del carrito
m0   = 10;       % Masa inicial [kg]
mmin = 6;        % Masa minima [kg]
Tm   = 20;       % Tiempo para alcanzar la masa minima [s]

r  = 0.10;       % Radio de rueda [m]
d  = 0.25;       % Semidistancia entre ruedas [m]
J  = 0.50;       % Momento de inercia del carrito [kg m^2]
bv = 1.0;        % Friccion longitudinal
bw = 0.10;       % Friccion rotacional

%% 2. Ganancias del controlador
kx     = 1.5;
ky     = 2.0;
ktheta = 2.5;

kv = 5.0;        % Control interno de velocidad lineal
kw = 5.0;        % Control interno de velocidad angular

%% 3. Trayectoria deseada: circulo
R  = 2.0;        % Radio [m]
Om = 0.20;       % Velocidad angular de referencia [rad/s]

T  = 40;         % Tiempo total [s]
dt = 0.001;      % Paso de simulacion [s]
t  = 0:dt:T;
N  = length(t);

% Estado: [x; y; theta; v; omega]
q = zeros(5,N);

% Condicion inicial
q(:,1) = [0; 0; 0; 0; 0];

% Variables para guardar resultados
M       = zeros(1,N);
vd      = zeros(1,N);
wd      = zeros(1,N);
tauR    = zeros(1,N);
tauL    = zeros(1,N);
ex_hist = zeros(1,N);
ey_hist = zeros(1,N);
eth_hist = zeros(1,N);

%% 4. Simulacion en lazo cerrado
for k = 1:N-1

    tk = t(k);

    % Masa decreciente hasta mmin, y constante despues
    M(k) = m0 - (m0-mmin)*min(tk/Tm,1);

    % Trayectoria deseada
    xd  = R*cos(Om*tk);
    yd  = R*sin(Om*tk);
    thd = Om*tk + pi/2;

    % Velocidades de referencia
    vr = R*Om;
    wr = Om;

    % Estado actual
    x  = q(1,k);
    y  = q(2,k);
    th = q(3,k);
    v  = q(4,k);
    w  = q(5,k);

    % Errores en coordenadas del carrito
    ex =  cos(th)*(xd-x) + sin(th)*(yd-y);
    ey = -sin(th)*(xd-x) + cos(th)*(yd-y);
    eth = atan2(sin(thd-th),cos(thd-th));

    ex_hist(k) = ex;
    ey_hist(k) = ey;
    eth_hist(k) = eth;

    % Control externo: seguimiento de trayectoria
    vd(k) = vr*cos(eth) + kx*ex;
    wd(k) = wr + ky*vr*ey + ktheta*sin(eth);

    % Derivadas numericas de las referencias de velocidad
    if k == 1
        avd = 0;
        awd = 0;
    else
        avd = (vd(k)-vd(k-1))/dt;
        awd = (wd(k)-wd(k-1))/dt;
    end

    % Control interno: aceleraciones deseadas
    av = avd - kv*(v-vd(k));
    aw = awd - kw*(w-wd(k));

    % Suma y diferencia de torques
    S = M(k)*r*av + bv*r*v;
    D = (J*r/d)*aw + (bw*r/d)*w;

    % Torques de las ruedas
    tauR(k) = (S+D)/2;
    tauL(k) = (S-D)/2;

    % Dinamica del carrito
    dq = zeros(5,1);
    dq(1) = v*cos(th);
    dq(2) = v*sin(th);
    dq(3) = w;
    dq(4) = (tauR(k)+tauL(k))/(M(k)*r) ...
             - (bv/M(k))*v;
    dq(5) = d*(tauR(k)-tauL(k))/(J*r) ...
             - (bw/J)*w;

    % Integracion de Euler
    q(:,k+1) = q(:,k) + dt*dq;
end

M(N) = m0 - (m0-mmin)*min(t(N)/Tm,1);
vd(N) = vd(N-1);
wd(N) = wd(N-1);
tauR(N) = tauR(N-1);
tauL(N) = tauL(N-1);

%% 5. Trayectoria deseada
xd = R*cos(Om*t);
yd = R*sin(Om*t);

%% 6. Graficas
figure('Color','w');

subplot(2,2,1)
plot(xd,yd,'r--','LineWidth',1.8); hold on;
plot(q(1,:),q(2,:),'b','LineWidth',1.4);
plot(q(1,1),q(2,1),'ko','MarkerFaceColor','k');
axis equal; grid on;
xlabel('x [m]'); ylabel('y [m]');
title('Seguimiento de trayectoria');
legend('Deseada','Carrito','Inicio','Location','best');

subplot(2,2,2)
plot(t,M,'LineWidth',1.6);
grid on; xlabel('Tiempo [s]');
ylabel('Masa [kg]');
title('Masa variable');

subplot(2,2,3)
plot(t,q(4,:),'b','LineWidth',1.3); hold on;
plot(t,vd,'r--','LineWidth',1.3);
plot(t,q(5,:),'k','LineWidth',1.3);
plot(t,wd,'m--','LineWidth',1.3);
grid on; xlabel('Tiempo [s]');
title('Seguimiento de velocidades');
legend('v','v_d','\omega','\omega_d');

subplot(2,2,4)
plot(t,tauR,'b','LineWidth',1.2); hold on;
plot(t,tauL,'r','LineWidth',1.2);
grid on; xlabel('Tiempo [s]');
ylabel('Torque [N m]');
title('Torques de las ruedas');
legend('\tau_R','\tau_L');
